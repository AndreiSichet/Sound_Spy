# Python environments and caches (any depth)
.venv/
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.ruff_cache/
.ipynb_checkpoints/

# Node / frontend
node_modules/
frontend/dist/

# Editor
.vscode/

# Databases
*.db
*.db-journal

# Experiments: config.json, metrics.json, thresholds.json and plots/ are tracked;
# checkpoints and logs are not
experiments/*/checkpoints/
experiments/*/logs/
experiments/*/log.csv
experiments/*/*.log

# Data, models and outputs: ignore contents, keep the folder skeleton (.gitkeep)
data/**
!data/**/
!data/**/.gitkeep
models/*
!models/.gitkeep
outputs/*
!outputs/.gitkeep
